# 운영 배포용 환경변수 예시. /opt/coinflow/.env 로 복사해 값을 채운다.
# 실제 값이 들어간 .env 는 커밋하지 않는다.

# DB
DB_USERNAME=coinflow
DB_PASSWORD=your-strong-password
MYSQL_ROOT_PASSWORD=your-strong-root-password
DB_POOL_MAX_SIZE=10

# JWT (32바이트 이상). 비워 두면 compose 가 기동을 거부한다.
JWT_SECRET=replace-with-random-secret-at-least-32-bytes

# backend 포트를 바인딩할 주소. 앞단에 프록시를 두면 127.0.0.1 로 바꾼다.
BACKEND_BIND_ADDRESS=0.0.0.0
